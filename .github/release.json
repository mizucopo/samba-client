{
  "version": {
    "scheme": "semver",
    "sources": [
      {
        "path": "version",
        "format": "text"
      }
    ],
    "locks": [
    ]
  },
  "publication": {
    "release_tag": "{version}",
    "github_release": true,

    "release_paths": ["version", "Dockerfile"],
    "latest_image": "extended",
    "images": [
      {
        "name": "extended",
        "repository": "mizucopo/samba-client",
        "tag": "{version}",
        "aliases": ["latest"],
        "registry": "dockerhub"
      }
    ]
  }
}
